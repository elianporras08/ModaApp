<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Foto de la prenda alineada y sin deformaciones -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="140dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/fondo_gris"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivFotoItem"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_gallery"
                android:contentDescription="Foto de la prenda" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Modelo de la prenda -->
        <TextView
            android:id="@+id/tvModeloItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Polo oversize"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="8dp" />

        <!-- Talla y Color -->
        <TextView
            android:id="@+id/tvDetalleItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Talla M · Azul"
            android:textSize="12sp"
            android:textColor="#757575"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <!-- Fila de Precio y Botón (+) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvPrecioItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="S/ 39.90"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/rosa_moda" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAgregarItem"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:text="+"
                android:textSize="18sp"
                android:padding="0dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@color/rosa_moda"
                app:cornerRadius="18dp" />
        </RelativeLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>