<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="1dp"
    app:strokeColor="#F0F0F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Foto miniatura de la prenda -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/fondo_gris"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivFotoCarrito"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_gallery"
                android:contentDescription="Miniatura de prenda" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Información: Nombre, Talla, Color y Cantidad -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvModeloCarrito"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Polo oversize · M"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvDetalleCarrito"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Azul · 2 x S/ 39.90"
                android:textSize="12sp"
                android:textColor="#757575"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Subtotal acumulado de la prenda -->
        <TextView
            android:id="@+id/tvSubtotalCarrito"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S/ 79.80"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/rosa_moda" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>