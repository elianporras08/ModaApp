<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="#F0F0F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Miniatura de la foto -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/fondo_gris"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivFotoGestion"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_gallery"
                android:contentDescription="Foto prenda" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Información de la prenda -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvModeloGestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Polo Oversize"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tvDetalleGestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Marca: Nike · Stock: 20"
                android:textSize="12sp"
                android:textColor="#757575" />

            <TextView
                android:id="@+id/tvPrecioGestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S/ 45.00"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/rosa_moda" />
        </LinearLayout>

        <!-- Botón Editar -->
        <ImageButton
            android:id="@+id/btnEditarRopa"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/rosa_moda"
            android:contentDescription="Editar" />

        <!-- Botón Eliminar -->
        <ImageButton
            android:id="@+id/btnEliminarRopa"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="#D32F2F"
            android:contentDescription="Eliminar" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>